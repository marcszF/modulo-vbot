CaveBotEditorButton < Button

CaveBotEditorPanel < Panel
  id: cavebotEditor
  visible: false
  layout:
    type: verticalBox
    fit-children: true

  Label
    id: pos
    text-align: center
    text: -

  Panel
    id: buttons
    margin-top: 2
    height: 240

    Panel
      id: buttonsLeft
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 83
      layout:
        type: verticalBox

    Panel
      id: buttonsRight
      anchors.top: parent.top
      anchors.left: buttonsLeft.right
      anchors.bottom: parent.bottom
      margin-left: 4
      width: 83
      layout:
        type: verticalBox

  Label
    text: Double click on action from action list to edit it
    text-align: center
    text-auto-resize: true
    text-wrap: true
    margin-top: 3
    margin-left: 2
    margin-right: 2

  BotSwitch
    id: autoRecording
    text: Auto Recording
    margin-top: 3

  BotButton
    margin-top: 3
    margin-bottom: 3
    text: Documentation
    @onClick: g_platform.openUrl("http://bot.otclient.ovh/")
